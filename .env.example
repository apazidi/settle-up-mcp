# Real values belong only in an untracked .env or deployment secret store.
# Register an application at https://developers.settleup.io/ for its API key.
SETTLEUP_FIREBASE_API_KEY=
SETTLEUP_BASE_URL=https://settle-up-sandbox.firebaseio.com

# Settle Up: Firebase refresh token OR email/password.
# This is a Firebase session token, NOT a Google access token or the API key.
SETTLEUP_REFRESH_TOKEN=
SETTLEUP_EMAIL=
SETTLEUP_PASSWORD=

# MCP: token (default), google, or none (loopback development only).
MCP_AUTH_MODE=token
MCP_AUTH_TOKEN=

# Required for MCP_AUTH_MODE=google. Leave MCP_AUTH_TOKEN empty then.
MCP_PUBLIC_URL=https://mcp.example.com
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=
MCP_GOOGLE_ALLOWED_EMAIL=
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_OAUTH_SIGNING_KEY=
# Copy the exact callback shown by ChatGPT. Comma-separate additional callbacks.
MCP_OAUTH_CLIENT_REDIRECT_URIS=

# Docker sets FASTMCP_HOME to a persistent volume automatically.
# Outside Docker, choose a private directory outside the source checkout.
# FASTMCP_HOME=/path/to/oauth-state
LOG_LEVEL=INFO
