# Copy this file to .env. Then write your own values.
# Caution: Never commit the .env file.

# The Settle Up account.
SETTLEUP_EMAIL=you@example.com
SETTLEUP_PASSWORD=change-me

# The Firebase Web API key of the Settle Up project.
# This value is the public sandbox key. Ask Settle Up for the live key.
SETTLEUP_FIREBASE_API_KEY=AIzaSyCBsW4lveImpcB92c-cnNg2VQgx9JdijU8

# The API server. Use the sandbox first.
# Sandbox: https://settle-up-sandbox.firebaseio.com
# Live:    https://settle-up-live.firebaseio.com
SETTLEUP_BASE_URL=https://settle-up-sandbox.firebaseio.com

# The bearer token that each agent must send.
# Leave this empty for local tests only.
MCP_AUTH_TOKEN=

# The server network settings.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO
