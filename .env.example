# Copy this file to .env. Then write your values.
# Caution: Never commit the .env file.
# For the API key and the server URLs, read https://api.settleup.io

SETTLEUP_EMAIL=you@example.com
SETTLEUP_PASSWORD=change-me
SETTLEUP_FIREBASE_API_KEY=change-me

# The sandbox is the default. Use the live URL only after your tests pass.
SETTLEUP_BASE_URL=https://settle-up-sandbox.firebaseio.com

# The bearer token that each agent must send.
# Caution: An empty value lets each request through.
MCP_AUTH_TOKEN=

LOG_LEVEL=INFO
